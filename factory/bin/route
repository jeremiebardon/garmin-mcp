#!/usr/bin/env python
"""Map intake's risk and surfaces to the job's agent set.

Usage: route <job-id>

Reads `risk` and `surfaces` from intake.md (through job.json), looks them up in
config.json's `routing` and `surface_reviewers` tables, and records the result
in job.json with `job agents`. Prints the agent set.
"""

import json
import subprocess
import sys
from pathlib import Path

sys.stdout.reconfigure(encoding="utf-8")  # Windows consoles default to cp1252
sys.stderr.reconfigure(encoding="utf-8")

FACTORY = Path(__file__).resolve().parents[1]
CONFIG = json.loads((FACTORY / "config.json").read_text(encoding="utf-8"))


def die(msg):
    print(f"route: {msg}", file=sys.stderr)
    sys.exit(1)


def job_cmd(*args):
    res = subprocess.run([sys.executable, str(FACTORY / "bin" / "job"), *args],
                         capture_output=True, encoding="utf-8", errors="replace")
    if res.returncode != 0:
        die(res.stderr.strip())


def main(argv):
    if len(argv) != 1:
        die("usage: route <job-id>")
    job_id = argv[0]
    job_cmd("sync", job_id)
    job = json.loads((FACTORY / "jobs" / job_id / "job.json").read_text(encoding="utf-8"))
    intake = job["intake"] or die(f"{job_id} has no intake.md")
    risk = CONFIG["routing"].get(intake["risk"]) or die(
        f"risk {intake['risk']!r} isn't in config.json routing ({', '.join(CONFIG['routing'])})")
    reviewers = {k: v for k, v in risk.items() if k != "builder"}
    for surface in intake["surfaces"]:
        extra = CONFIG["surface_reviewers"].get(surface)
        if extra is None:
            die(f"surface {surface!r} isn't in config.json surface_reviewers ({', '.join(CONFIG['surface_reviewers'])})")
        reviewers.update(extra)
    agents = {"builder": risk["builder"], "reviewers": reviewers}
    job_cmd("agents", job_id, json.dumps(agents))
    print(f"{job_id}: builder {agents['builder']}, reviewers "
          + ", ".join(f"{k} {v}" for k, v in reviewers.items()))


if __name__ == "__main__":
    main(sys.argv[1:])
