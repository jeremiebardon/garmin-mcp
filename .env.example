# Garmin Personal API key (required, mcp only)
GARMIN_PERSONAL_API_KEY=
# Password of the garmin Postgres role (required)
POSTGRES_PASSWORD=
# Password of the phoenix Postgres role (required)
PHOENIX_DB_PASSWORD=
# Host port of the MCP server (optional, default 3000)
MCP_PORT=
# Host port of Postgres (optional, default 5432)
POSTGRES_PORT=
# Host port of the Phoenix UI and OTLP (optional, default 6006)
PHOENIX_PORT=
# Server log level (optional, default info)
LOG_LEVEL=
# Days Phoenix keeps traces (optional, default 30)
PHOENIX_RETENTION_DAYS=
